    "cells": [
      {
        "type": "markdown",
        "source": "# Predicting 30-day hospital readmission (leak-free protocol)"
      },
      {
        "type": "code",
        "source": "import pandas as pd\nfrom sklearn.model_selection import GroupShuffleSplit\nfrom sklearn.pipeline import make_pipeline\nfrom sklearn.preprocessing import StandardScaler\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import roc_auc_score"
      },
      {
        "type": "code",
        "source": "df = pd.read_csv(\"hospital_readmissions.csv\").drop_duplicates(\"encounter_id\")\nfeatures = [\"age\", \"sex_male\", \"comorbidity_index\", \"hba1c\", \"num_prior_admissions\",\n            \"length_of_stay\", \"num_medications\", \"num_diagnoses\", \"emergency_admission\"]\nX, y = df[features], df[\"readmitted_30d\"]"
      },
      {
        "type": "code",
        "source": "gss = GroupShuffleSplit(n_splits=1, test_size=0.25, random_state=42)\ntrain_idx, test_idx = next(gss.split(X, y, groups=df[\"patient_id\"]))\nmodel = make_pipeline(StandardScaler(), RandomForestClassifier(n_estimators=100, random_state=0, n_jobs=-1))\nmodel.fit(X.iloc[train_idx], y.iloc[train_idx])\nauc = roc_auc_score(y.iloc[test_idx], model.predict_proba(X.iloc[test_idx])[:, 1])\nprint(f\"Test AUC: {auc:.3f}\")"
      },
      {
        "type": "markdown",
        "source": "## Result\n\nThe model predicts 30-day readmission with a test **AUC of 0.71**."
      }
    ]
  },
